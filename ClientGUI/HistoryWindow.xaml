<Window x:Class="ClientGUI.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ClientGUI"
        mc:Ignorable="d"
        Title="HistoryWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="История" 
               HorizontalAlignment="Center" Margin="10"
               Padding="10"/>

        <ListBox Grid.Row="1" x:Name="ListHistory" Margin="10" FontFamily="Consolas"/>

        <Button Grid.Row="2" Content="Закрыть" 
            Click="BtnClose_Click" Margin="10"/>
    </Grid>
</Window>
