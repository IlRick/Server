<Window x:Class="ClientGUI1.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ClientGUI1"
        mc:Ignorable="d"
        Title="RegisterWindow" Height="450" Width="800">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Регистрация" 
               HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="Логин:" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtLogin" Padding="5" Height="30"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="Пароль:" Margin="0,0,0,5"/>
            <PasswordBox x:Name="TxtPassword" Padding="5" Height="30"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,0,0,10">
            <TextBlock Text="Путь к папке:" Margin="0,0,0,5"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="TxtPath" Padding="5" Height="30" Margin="0,0,10,0"/>
                <Button Grid.Column="1" Content="..." Width="40" Height="30" Click="BtnBrowse_Click"/>
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" >
            <Button Content="Зарегистрироваться"
                Click="BtnRegister_Click"
               Margin="0,0,10,0"/>
            <Button Content="Отмена" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
